# Deific Digital - safe defaults for Apache hosts (Hostinger / cPanel). Ignored by Netlify, Vercel, GitHub Pages.
# Keep a backup of any existing .htaccess before replacing it.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) www -> non-www and force HTTPS (one 301, no loop behind Cloudflare/proxies)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 0a) Security: never serve dotfiles (.env, .git) or the admin/duplicate folders
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(deific|deific-admin|node_modules)(/|$) - [F,L,NC]

# 0) Old / short URLs -> real pages (301). Case-insensitive, with or without trailing slash.
RewriteRule ^products/prop-ai(/|/index\.html)?$ /propai [NC,L,R=301]
RewriteRule ^liv-pro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^livpro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^liv_pro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^liv-pro-app/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^products/livpro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^products/liv_pro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^product/liv-pro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^product/livpro/?$ /products/liv-pro [NC,L,R=301]
RewriteRule ^review-ninja-pro/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^review-ninja/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^reviewninja/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^reviewninjapro/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^products/review-ninja/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^products/reviewninja/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^product/review-ninja-pro/?$ /products/review-ninja-pro [NC,L,R=301]
RewriteRule ^prop-ai/?$ /propai [NC,L,R=301]
RewriteRule ^products/propai/?$ /propai [NC,L,R=301]
RewriteRule ^product/propai/?$ /propai [NC,L,R=301]
RewriteRule ^product/prop-ai/?$ /propai [NC,L,R=301]
RewriteRule ^ai-receptionist/?$ /products/ai-receptionist [NC,L,R=301]
RewriteRule ^ai-sales-agent/?$ /products/ai-sales-agent [NC,L,R=301]
RewriteRule ^ai-customer-support/?$ /products/ai-customer-support [NC,L,R=301]
RewriteRule ^product/?$ /products [NC,L,R=301]
RewriteRule ^service/?$ /services [NC,L,R=301]
RewriteRule ^industry/?$ /industries [NC,L,R=301]
RewriteRule ^blogs/?$ /blog [NC,L,R=301]
RewriteRule ^career/?$ /careers [NC,L,R=301]
RewriteRule ^jobs/?$ /careers [NC,L,R=301]
RewriteRule ^contact-us/?$ /contact [NC,L,R=301]
RewriteRule ^contactus/?$ /contact [NC,L,R=301]
RewriteRule ^about-us/?$ /about [NC,L,R=301]
RewriteRule ^aboutus/?$ /about [NC,L,R=301]
RewriteRule ^privacy/?$ /privacy-policy [NC,L,R=301]
RewriteRule ^terms/?$ /terms-and-condition [NC,L,R=301]
RewriteRule ^terms-and-conditions/?$ /terms-and-condition [NC,L,R=301]
RewriteRule ^terms-conditions/?$ /terms-and-condition [NC,L,R=301]
RewriteRule ^dubai/?$ /uae [NC,L,R=301]
RewriteRule ^ae/?$ /uae [NC,L,R=301]
RewriteRule ^ar/?$ /uae/ar [NC,L,R=301]
RewriteRule ^arabic/?$ /uae/ar [NC,L,R=301]
RewriteRule ^home/?$ / [NC,L,R=301]

# 1b) Clean URLs: /page/index.html -> /page and /page/ -> /page (301), serve /page from /page/index.html
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301,NE]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# Custom 404 page (styled at any URL depth because it uses /absolute paths)
ErrorDocument 404 /404.html

# Needed so Apache does not 301 /page to /page/ before the rewrite above
DirectorySlash Off

# 2) Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# 3) Browser caching (images, fonts, css, js = 1 year; html = 1 hour)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 1 hour"
</IfModule>
