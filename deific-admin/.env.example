# Copy this file to ".env" and change what you need.

# Folder of your website (the one with index.html, blog/, products/, assets/).
# Relative paths are resolved from this admin folder.
SITE_DIR=../website

# Port for the Node server
PORT=3000

# Public website address (used for canonical links and sitemap)
SITE_URL=https://deificdigital.com

# true  = this Node server also serves the website itself (recommended on a VPS / Render / Railway)
# false = only /admin runs here; your website files are served by Nginx/Apache from SITE_DIR
SERVE_SITE=true

# Set true when the site runs on HTTPS (production)
COOKIE_SECURE=false

# Set true when running behind Nginx / a load balancer (correct client IPs for login limits)
TRUST_PROXY=false

# Where admin data (users, posts, products, backups) is stored
DATA_DIR=data

# Optional: fixed secret for login sessions (otherwise one is generated in data/.secret)
# JWT_SECRET=change-me-to-a-long-random-string

# --- Auto-managed (admin panel ye khud likhta hai, manually bharna zaroori nahi) ---
# RECOVERY_KEY  : "Forgot password" screen par yahi key chahiye. Pehli baar start par khud ban jaati hai.
# ADMIN_USERNAME / ADMIN_PASSWORD : admin ka latest username + password (plain text). .env ko kabhi share/commit na karein.

# --- Fixed admin login (optional) ---
# Yaha email + password likhein, server start par is naam se admin ban jaata hai (ya update ho jaata hai).
# Is email ko Username box me daalkar login karein. Password kam se kam 8 characters.
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=YourStrongPassword123
