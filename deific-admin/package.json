{
  "name": "deific-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Admin panel (Node.js + React) for the Deific Digital static website",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "reset-password": "node server/reset-password.js",
    "list-users": "node server/list-users.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.10.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.13.1"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "quill": "1.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "vite": "^5.4.10"
  }
}
